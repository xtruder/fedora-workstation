#!/usr/bin/env bash
set -euo pipefail

{{- if or .hermes .hermes_web }}
# Shared Agent v2026.8.19 dependency.
installer=$(mktemp)
trap 'rm -f "$installer"' EXIT
curl -fsSL \
  https://hermes-agent.nousresearch.com/install.sh \
  -o "$installer"
bash "$installer" \
  --commit fcbd1076a93841fa88855acce810e342a5b78101 \
  --force-commit \
  --skip-setup \
  --skip-computer-use \
  --skip-browser \
  --non-interactive

git -C "$HOME/.hermes/hermes-agent" checkout --detach fcbd1076a93841fa88855acce810e342a5b78101
"$HOME/.hermes/bin/uv" pip install \
  --python "$HOME/.hermes/hermes-agent/venv/bin/python" \
  --editable "$HOME/.hermes/hermes-agent[all]"
ln -sfn "$HOME/.hermes/hermes-agent/venv/bin/hermes" "$HOME/.local/bin/hermes"

# Cua Driver 0.20.0 for the Agent API profile.
curl -fsSL \
  https://github.com/trycua/cua/releases/download/cua-driver-rs-v0.20.0/install.sh \
  -o "$installer"
printf '%s  %s\n' \
  317ba3a49fdba10f2a7f1b9f392c1bc1b7657f3aae85e1e2e43684cf17a1bf3b \
  "$installer" | sha256sum --check
CUA_DRIVER_RS_VERSION=cua-driver-rs-v0.20.0 bash "$installer"

# WinRects GNOME Shell extension (bundled in the cua-driver tarball): window
# screen geometry + agent cursor on GNOME Mutter Wayland. Without it,
# cua-driver captures hang on this headless GNOME Wayland session. Also
# listed in dconf.ini enabled-extensions; GNOME Shell loads it at
# session start.
winrects_src="$HOME/.cua-driver/packages/current/wayland-helper/winrects@cua"
if [[ -d "$winrects_src" ]]; then
    winrects_dest="$HOME/.local/share/gnome-shell/extensions/winrects@cua"
    mkdir -p "$winrects_dest"
    cp -f "$winrects_src/metadata.json" "$winrects_src/extension.js" "$winrects_dest/"
    winrects_cur=$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || echo "@as []")
    python3 - "$winrects_cur" "winrects@cua" <<'PY'
import ast
import subprocess
import sys

cur, uuid = sys.argv[1], sys.argv[2]
try:
    enabled = ast.literal_eval(cur)
except Exception:
    enabled = []
if not isinstance(enabled, list):
    enabled = []
if uuid not in enabled:
    enabled.append(uuid)
    subprocess.run(
        ["gsettings", "set", "org.gnome.shell", "enabled-extensions", str(enabled)],
        check=True,
    )
print("enabled-extensions ->", enabled)
PY
fi

# The upstream installer owns this messaging unit. This profile uses its own
# API-enabled unit so chezmoi remains authoritative.
systemctl --user disable --now hermes-gateway.service 2>/dev/null || true
{{- end }}

{{- if .hermes_web }}
# WebUI exp-v0.52.262.
if [[ ! -d $HOME/.hermes/hermes-webui/.git ]]; then
  git clone https://github.com/nesquena/hermes-webui.git "$HOME/.hermes/hermes-webui"
fi
git -C "$HOME/.hermes/hermes-webui" fetch origin df65251d58191f1de4ca1894a0bc5b399ce4a4ec
git -C "$HOME/.hermes/hermes-webui" checkout --detach df65251d58191f1de4ca1894a0bc5b399ce4a4ec
"$HOME/.hermes/bin/uv" pip install \
  --python "$HOME/.hermes/hermes-agent/venv/bin/python" \
  --editable "$HOME/.hermes/hermes-webui"
{{- end }}
