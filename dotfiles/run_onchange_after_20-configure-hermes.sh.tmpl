#!/usr/bin/env bash
set -euo pipefail

{{- if .hermes }}
# Re-run when the helper or service definitions change.
# configure-hermes: {{ include "private_dot_local/bin/executable_configure-hermes" | sha256sum }}
# hermes-api.service: {{ include "dot_config/systemd/user/hermes-api.service" | sha256sum }}
# hermes-webui.service: {{ include "dot_config/systemd/user/hermes-webui.service" | sha256sum }}
"$HOME/.local/bin/configure-hermes"
{{- else }}
systemctl --user disable --now \
  hermes-api.service \
  hermes-webui.service \
  gnome-remote-desktop.service 2>/dev/null || true
rm -f \
  "$HOME/.config/systemd/user/hermes-api.service" \
  "$HOME/.config/systemd/user/hermes-webui.service" \
  "$HOME/.config/systemd/user/graphical-session.target.wants/hermes-api.service" \
  "$HOME/.config/systemd/user/default.target.wants/hermes-webui.service" \
  "$HOME/.config/systemd/user/default.target.wants/gnome-remote-desktop.service" \
  "$HOME/.local/bin/configure-hermes"
systemctl --user daemon-reload
{{- end }}
