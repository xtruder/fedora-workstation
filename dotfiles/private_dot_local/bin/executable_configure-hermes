#!/usr/bin/env bash
set -euo pipefail

item=op://Private/Hermes
config_dir=$HOME/.config/hermes
rdp_dir=$HOME/.local/share/gnome-remote-desktop

command -v op >/dev/null || {
  printf '1Password CLI is unavailable. Install or enable it before configuring Hermes.\n' >&2
  exit 1
}
op whoami >/dev/null || {
  printf 'Sign in to 1Password and enable desktop app CLI integration, then re-run this command.\n' >&2
  exit 1
}

read_secret() {
  local value
  value=$(op read "$item/$1")
  if [[ $value == *$'\n'* ]]; then
    printf '%s must not contain newlines.\n' "$1" >&2
    exit 1
  fi
  printf '%s' "$value"
}

write_env() {
  local value=$2
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s=' "$1"
  printf '"%s"\n' "$value"
}

install -d -m 0700 "$config_dir" "$rdp_dir"
umask 077
{
  printf 'API_SERVER_ENABLED=true\n'
  printf 'API_SERVER_HOST=127.0.0.1\n'
  write_env API_SERVER_KEY "$(read_secret API_SERVER_KEY)"
  printf 'HERMES_DASHBOARD=1\n'
  printf 'HERMES_DASHBOARD_HOST=127.0.0.1\n'
  printf 'HERMES_DASHBOARD_PORT=9119\n'
  write_env HERMES_DASHBOARD_BASIC_AUTH_USERNAME "$(read_secret DASHBOARD_USERNAME)"
  write_env HERMES_DASHBOARD_BASIC_AUTH_PASSWORD "$(read_secret DASHBOARD_PASSWORD)"
  write_env HERMES_DASHBOARD_BASIC_AUTH_SECRET "$(read_secret DASHBOARD_SECRET)"
  printf 'HERMES_WEBUI_HOST=127.0.0.1\n'
  printf 'HERMES_WEBUI_PORT=8787\n'
  printf 'HERMES_WEBUI_STATE_DIR=%s/.hermes/webui\n' "$HOME"
  printf 'HERMES_WEBUI_CHAT_BACKEND=gateway\n'
  printf 'HERMES_WEBUI_GATEWAY_BASE_URL=http://127.0.0.1:8642\n'
  printf 'HERMES_WEBUI_GATEWAY_USE_RUNS_API=true\n'
  write_env HERMES_WEBUI_GATEWAY_API_KEY "$(read_secret API_SERVER_KEY)"
  write_env HERMES_WEBUI_PASSWORD "$(read_secret WEBUI_PASSWORD)"
} > "$config_dir/services.env"

if [[ ! -s $rdp_dir/tls.crt || ! -s $rdp_dir/tls.key ]]; then
  openssl req -new -newkey rsa:4096 -days 720 -nodes -x509 \
    -subj "/O=Hermes/CN=$(hostname)" \
    -out "$rdp_dir/tls.crt" \
    -keyout "$rdp_dir/tls.key"
fi

gsettings set org.gnome.desktop.remote-desktop.rdp tls-key "$rdp_dir/tls.key"
gsettings set org.gnome.desktop.remote-desktop.rdp tls-cert "$rdp_dir/tls.crt"
grdctl rdp set-credentials "$(read_secret RDP_USERNAME)" "$(read_secret RDP_PASSWORD)"
grdctl rdp disable-view-only
grdctl rdp disable-port-negotiation
grdctl rdp enable
gsettings set org.gnome.desktop.session idle-delay 0
gsettings set org.gnome.desktop.screensaver lock-enabled false

systemctl --user daemon-reload
systemctl --user restart hermes-api.service hermes-webui.service gnome-remote-desktop.service
