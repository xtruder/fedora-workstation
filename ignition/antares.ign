      {
        "group": {
          "name": "offlinehq"
        },
        "path": "/home/offlinehq/.config/chezmoi",
        "user": {
          "name": "offlinehq"
        },
        "mode": 448
      }
    ],
    "disks": [
      {
        "device": "/dev/sda",
        "partitions": [
          {
            "label": "boot",
            "number": 3,
            "sizeMiB": 2048,
            "startMiB": 129,
            "typeGuid": "bc13c2ff-59e6-4262-a352-b275fd6f7172",
            "wipePartitionEntry": true
          },
          {
            "label": "root",
            "number": 4,
            "sizeMiB": 0,
            "startMiB": 2177,
            "typeGuid": "4f68bce3-e8cd-4db1-96e7-fbcaf984b709",
            "wipePartitionEntry": true
          }
        ],
        "wipeTable": false
      }
    ],
    "files": [
      {
        "overwrite": true,
        "path": "/etc/fstab",
        "contents": {
          "compression": "",
          "source": "data:,LABEL%3Dboot%20%2Fboot%20ext4%20defaults%200%202%0ALABEL%3DEFI-SYSTEM%20%2Fboot%2Fefi%20vfat%20umask%3D0077%2Cshortname%3Dwinnt%200%202%0A"
        },
        "mode": 420
      },
      {
        "overwrite": true,
        "path": "/etc/hostname",
        "contents": {
          "compression": "",
          "source": "data:,antares"
        },
        "mode": 420
      },
      {
        "overwrite": true,
        "path": "/etc/gdm/custom.conf",
        "contents": {
          "compression": "",
          "source": "data:,%5Bdaemon%5D%0AAutomaticLoginEnable%3DTrue%0AAutomaticLogin%3Dofflinehq%0A"
        },
        "mode": 420
      },
      {
        "group": {
          "name": "offlinehq"
        },
        "overwrite": true,
        "path": "/home/offlinehq/.config/chezmoi/chezmoi.toml",
        "user": {
          "name": "offlinehq"
