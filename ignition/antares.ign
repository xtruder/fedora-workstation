          "compression": "",
          "source": "data:,SYMLINK%3D%3D%22virtio-ports%2Forg.linuxcontainers.incus%22%2C%20TAG%2B%3D%22systemd%22%2C%20ENV%7BSYSTEMD_WANTS%7D%2B%3D%22incus-agent.service%22%0A"
        },
        "mode": 256
      },
