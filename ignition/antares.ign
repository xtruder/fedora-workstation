  "systemd": {
    "units": [
      {
        "enabled": true,
        "name": "sshd.service"
      },
      {
        "mask": true,
        "name": "sshd.socket"
      },
      {
        "enabled": true,
        "name": "systemd-timesyncd.service"
      },
      {
        "contents": "[Unit]\nDescription=Mount Incus agent 9p config\n\n[Mount]\nWhat=config\nWhere=/run/incus_9pconfig\nType=9p\nOptions=access=0,trans=virtio,size=1048576\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": false,
        "name": "run-incus_9pconfig.mount"
      },
      {
        "contents": "[Unit]\nDescription=Automount Incus agent 9p config\n\n[Automount]\nWhere=/run/incus_9pconfig\nTimeoutIdleSec=15\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "run-incus_9pconfig.automount"
      },
      {
        "contents": "[Unit]\nDescription=Mount tmpfs for Incus agent\n\n[Mount]\nWhat=tmpfs\nWhere=/run/incus_agent\nType=tmpfs\nOptions=noatime,nosuid,nodev,mode=0700,size=50M\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "run-incus_agent.mount"
      },
      {
        "contents": "[Unit]\nDescription=Install Incus agent SELinux policy\nConditionFirstBoot=yes\nBefore=incus-agent.service\nAfter=run-incus_agent.mount\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/semodule -i /etc/cil/run-incus_agent-incus--agent.cil\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "setup-incus-agent.service"
      },
      {
        "contents": "[Unit]\nDescription=Incus agent\nDocumentation=https://linuxcontainers.org/incus/docs/main/\nBefore=multi-user.target\nDefaultDependencies=no\nAfter=run-incus_agent.mount\n\n[Service]\nType=notify\nWorkingDirectory=-/run/incus_agent\nExecStartPre=/usr/bin/cp -Ra /run/incus_9pconfig/. /run/incus_agent\nExecStartPre=/usr/bin/restorecon -Rv /run/incus_agent\nExecStart=/run/incus_agent/incus-agent\nRestart=on-failure\nRestartSec=5s\nStartLimitInterval=60\nStartLimitBurst=10\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "incus-agent.service"
      },
      {
        "contents": "[Unit]\nDescription=Rebase to the unsigned Fedora workstation image\nConditionPathExists=!/etc/fedora-workstation-autorebase/unverified\nConditionPathExists=!/etc/fedora-workstation-autorebase/signed\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nStandardOutput=journal+console\nExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/xtruder/fedora-workstation:latest\nExecStart=/bin/bash -c 'cat /proc/sys/kernel/random/boot_id \u003e /etc/fedora-workstation-autorebase/unverified'\nExecStart=/usr/bin/systemctl disable fedora-workstation-unsigned-autorebase.service\nExecStart=/usr/bin/systemctl reboot\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "fedora-workstation-unsigned-autorebase.service"
      },
      {
        "contents": "[Unit]\nDescription=Rebase to the signed Fedora workstation image\nConditionPathExists=/etc/fedora-workstation-autorebase/unverified\nConditionPathExists=!/etc/fedora-workstation-autorebase/signed\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nStandardOutput=journal+console\nExecCondition=/bin/bash -c 'test \"$(cat /etc/fedora-workstation-autorebase/unverified)\" != \"$(cat /proc/sys/kernel/random/boot_id)\"'\nExecCondition=/bin/bash -c 'rpm-ostree status --booted | grep -Fq \"ostree-unverified-registry:ghcr.io/xtruder/fedora-workstation:latest\"'\nExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/xtruder/fedora-workstation:latest\nExecStart=/bin/bash -c 'cat /proc/sys/kernel/random/boot_id \u003e /etc/fedora-workstation-autorebase/signed'\nExecStart=/usr/bin/systemctl disable fedora-workstation-signed-autorebase.service\nExecStart=/usr/bin/systemctl reboot\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "fedora-workstation-signed-autorebase.service"
      },
      {
        "contents": "[Unit]\nDescription=Finish Fedora workstation VM bootstrap\nConditionPathExists=/etc/fedora-workstation-autorebase/signed\nConditionPathExists=!/etc/fedora-workstation-autorebase/complete\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecCondition=/bin/bash -c 'test \"$(cat /etc/fedora-workstation-autorebase/signed)\" != \"$(cat /proc/sys/kernel/random/boot_id)\"'\nExecCondition=/bin/bash -c 'rpm-ostree status --booted | grep -Fq \"ostree-image-signed:docker://ghcr.io/xtruder/fedora-workstation:latest\"'\nExecStart=/usr/bin/loginctl enable-linger offlinehq\nExecStart=/usr/bin/systemctl set-default graphical.target\nExecStart=/usr/bin/systemctl enable --now sshd.service\nExecStart=/usr/bin/systemctl enable --now gdm.service\nExecStart=/usr/bin/touch /etc/fedora-workstation-autorebase/complete\nExecStart=/usr/bin/systemctl disable fedora-workstation-bootstrap.service\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "fedora-workstation-bootstrap.service"
      },
      {
        "contents": "[Unit]\nDescription=Initialize Fedora workstation dotfiles\nConditionPathExists=/etc/fedora-workstation-autorebase/signed\nConditionPathExists=/etc/fedora-workstation-autorebase/complete\nConditionPathExists=!/etc/fedora-workstation-autorebase/chezmoi\nAfter=network-online.target gdm.service fedora-workstation-bootstrap.service\nWants=network-online.target\n\n[Service]\nType=oneshot\nTimeoutStartSec=infinity\nExecStart=/etc/fedora-workstation-autorebase/initialize-chezmoi\nExecStart=/usr/bin/touch /etc/fedora-workstation-autorebase/chezmoi\nExecStart=/usr/bin/systemctl disable fedora-workstation-chezmoi.service\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "fedora-workstation-chezmoi.service"
      }
    ]
  }
}
