        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/1yOQQqDMBBF955icN/eQOiy9AqlyGgmdppMIskE9fYlbrRd/vf48J4GFV8NQEAh6KB9oEO4FxOd59A2ACTIvpoPOrytF03FULoG0mpt7nWb9+dqcyUcxpKhA4s+UwOwxOSgA02lrjFts8aTnlA4TCcgxSsLGcbj9aYklP93v9BwsAEz9SYKcthrfkK/AQAA///UJVLV5wAAAA=="
        },
        "mode": 384
      },
      {
        "overwrite": true,
        "path": "/etc/cil/run-incus_agent-incus--agent.cil",
        "contents": {
          "compression": "",
          "source": "data:,(filecon%20%22%2Frun%2Fincus_agent%2Fincus-agent%22%20any%20(system_u%20object_r%20bin_t%20((s0)(s0))))%0A"
        },
